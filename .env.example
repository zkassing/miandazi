// Xiaomi MiMo API Key (https://platform.xiaomimimo.com -> API Keys)
// IMPORTANT: do NOT commit a real key. Replace the placeholder with your own.
//
// 提示：以下所有模型配置都可以在网页右上角 ⚙️「模型配置」里运行时修改，
// 保存后立即生效、无需重启，并持久化到项目根目录 .model-settings.json
// （该文件已加入 .gitignore）。.env 里的值作为「默认值」，网页配置会覆盖它。
MIMO_API_KEY=sk-mimo-REPLACE_ME

// MiMo ASR base URL. The /v1/chat/completions endpoint accepts the OpenAI-style
// multimodal "input_audio" content type and is what mimo-v2.5-asr listens on.
MIMO_BASE_URL=https://api.xiaomimimo.com/v1/chat/completions

// Model id for STT.
MIMO_ASR_MODEL=mimo-v2.5-asr

// Model id / voice / format for TTS.
// Available voices on MiMo: mimo_default, 冰糖, 茉莉, 苏打, 白桦, Mia, Chloe, Milo, Dean
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=mimo_default
MIMO_TTS_FORMAT=wav

// Optional: a system prompt to bias the STT recognizer.
MIMO_SYSTEM_PROMPT=

// DeepSeek API Key (https://platform.deepseek.com -> API Keys)
DEEPSEEK_API_KEY=sk-REPLACE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
// Max rounds per interview (also configurable per-session from the UI).
DEEPSEEK_MAX_ROUNDS=8

// Interview session TTL in milliseconds (default 30 minutes).
INTERVIEW_SESSION_TTL_MS=1800000

// Server port
PORT=5174

// CORS origin
CORS_ORIGIN=*

// Max upload size in bytes (100 MB by default).
MAX_UPLOAD_BYTES=104857600
